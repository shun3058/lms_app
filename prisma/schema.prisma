generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lectures {
  id Int @id @default(autoincrement())
  my_lecture Boolean @default(false)
  lecture_name String 
  lecture_description String 
  teacher_name String 
  created_at DateTime @default(now())
}